rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{uid}/{file} {
      allow read: if request.auth != null && request.auth.token.email_verified == true && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.suspended == false;
      // Uploads are decoded, resized, stripped of metadata and re-encoded by the API.
      allow write: if false;
    }
  }
}
